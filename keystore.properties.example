# 릴리스 서명 정보 견본. 이 파일을 `keystore.properties`로 복사해 값을 채운다(그 파일은 .gitignore라 커밋되지 않는다).
# storeFile은 저장소 루트 기준 상대 경로나 절대 경로. 키스토어 파일도 저장소 밖(또는 .jks/.keystore라 무시되는 이름)에 둔다.
# CI에서는 같은 값을 환경 변수로 준다: COUP_KEYSTORE_FILE, COUP_KEYSTORE_PASSWORD, COUP_KEY_ALIAS, COUP_KEY_PASSWORD
storeFile=../coup-upload.jks
storePassword=
keyAlias=upload
keyPassword=
