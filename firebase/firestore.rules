rules_version = '2';

// 이 파일은 core/remote/src/test/.../FakeFirestore.kt 의 AccessPolicy(실행 가능한 모델)를 손으로 옮긴 것이다.
// 에뮬레이터 검증: firebase/rules-test (모델의 모든 허용/거부 판단을 이 규칙에 재생해 일치를 확인 + 규칙에서만 보이는 동작 확인).
// 규칙을 고치면 모델(AccessPolicy)도 함께 고치고 rules-test를 다시 돌릴 것.
// 정책을 바꿀 때는 AccessPolicy 와 이 파일을 함께 고친다. (설계 문서 §8.3, docs/adr/0005, 0007, 0015)
// 레이팅은 서버 판정(Cloud Function, 관리자 권한 — 규칙을 거치지 않는다)만 바꾼다(ADR 0015).
// 배치 쓰기에서 get()은 요청 전 상태, getAfter()/existsAfter()는 배치 전체가 적용된 뒤 상태를 읽는다(모델도 같다).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function gameData(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }

    function isHost(gameId) {
      return signedIn() && request.auth.uid == gameData(gameId).hostUid;
    }

    function isSeat(gameId) {
      return signedIn() && request.auth.uid in gameData(gameId).seats;
    }

    // 게임 문서: 좌석이면 읽기, 방장만 수정. 만드는 사람이 곧 방장이어야 한다.
    match /games/{gameId} {
      allow read: if isSeat(gameId);
      // 게임은 방에 묶인다(ADR 0008): 좌석 = 방에 스스로 들어온 사람 전원, rated = 방 구성, 시작 시각 = 서버 시각.
      allow create: if signedIn() && validGameCreate(gameId);
      // 방장은 진행 상태·버전·생존 신호만 바꾼다(ADR 0015). 좌석·rated·시작 시각은 만들 때 정해지고,
      // 판정(verdict)은 서버(관리자 권한)만 쓴다 — 방장이 진 판을 미리 "무효"로 적어 두지 못하게.
      // 진행 중인 판만 고칠 수 있고(서버가 버려진 판으로 끝낸 뒤에는 되살릴 수 없다), "끝남"은 결과 문서를 만드는 같은 배치에서만 —
      // 결과 없이 끝난 척해서 버려진 판 정리(ADR 0016)를 피하지 못하게.
      allow update: if isHost(gameId)
                    && resource.data.status == 'PLAYING'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'version', 'hostHeartbeatAt'])
                    && (request.resource.data.status == 'PLAYING'
                        || (request.resource.data.status == 'FINISHED'
                            && !exists(/databases/$(database)/documents/results/$(gameId))
                            && existsAfter(/databases/$(database)/documents/results/$(gameId))));
      allow delete: if false;

      // 좌석별 뷰: 자기 것만 읽는다. 관전 뷰는 좌석이면 읽는다. 쓰기는 방장만.
      match /views/{viewerId} {
        allow read: if signedIn()
                    && (viewerId == request.auth.uid
                        || (viewerId == 'spectator' && isSeat(gameId)));
        allow write: if isHost(gameId);
      }

      // 권한자 상태 백업(모든 플레이어의 비공개 카드 포함): 방장만. 실행 설정(setup)은 아래에서 따로 — 여기서는 고칠 수 없다.
      match /authority/{doc} {
        allow read: if isHost(gameId);
        allow write: if isHost(gameId) && doc != 'setup';
      }

      // 실행 설정(시드 포함, ADR 0015): 게임 문서를 만드는 같은 배치에서 방장이 만들 때만. 이후 수정·삭제 불가 —
      // 게임이 진행된 뒤 결과에 맞는 시드를 골라 넣지 못하게 한다. 서버(관리자 권한)가 끝난 게임을 다시 돌릴 때 읽는다.
      match /authority/setup {
        allow create: if signedIn()
                      && !exists(/databases/$(database)/documents/games/$(gameId))
                      && getAfter(/databases/$(database)/documents/games/$(gameId)).data.hostUid == request.auth.uid;
      }

      // 명령 기록(ADR 0015): 방장이 게시와 같은 배치로 만들기만. 문서 ID = 버전, 시각 = 서버 시각(꾸밀 수 없다). 고칠 수 없다.
      // 교환에서 고른 카드 같은 비공개 정보가 들어 있으므로 방장만 읽는다.
      match /log/{version} {
        allow read: if isHost(gameId);
        allow create: if isHost(gameId)
                      && request.resource.data.version is int
                      && string(request.resource.data.version) == version
                      && request.resource.data.at == request.time;
      }

      // 게스트 명령: 보낸 사람이 자기 uid로, 방장이 아닌 좌석으로, PENDING 상태로만 만든다.
      // 읽기는 방장 또는 보낸 사람. 상태 변경(승인/거절)은 방장만. 삭제 금지.
      match /commands/{commandId} {
        allow create: if isSeat(gameId)
                      && request.auth.uid != gameData(gameId).hostUid
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.status == 'PENDING';
        // 아직 없는 문서를 읽는 것(보낸 직후 승인 결과를 기다리는 구독)도 허용한다: resource가 null이면 resource.data 접근이 오류가 되어
        // 거부되므로 명시적으로 열어 둔다(에뮬레이터로 확인). 없는 문서는 아무 정보도 담지 않는다.
        allow get: if isHost(gameId)
                   || (isSeat(gameId) && (resource == null || resource.data.senderUid == request.auth.uid));
        allow list: if isHost(gameId);
        allow update: if isHost(gameId);
        allow delete: if false;
      }
    }

    // 종료 결과: 방장이 한 번 만들고 수정 불가. 순위는 공개 정보.
    // 레이팅 게임이면 순위는 정확히 사람 좌석 전원이어야 한다(가짜 uid를 끼워 넣거나 빼지 못하게).
    // 결과 화면이 보여 주는 변동량도 레이팅 표와 같아야 한다(실제 반영은 서버가 기록을 다시 돌려 계산한다, ADR 0015).
    match /results/{gameId} {
      allow read: if signedIn();
      allow create: if isHost(gameId)
                    && gameData(gameId).status == 'PLAYING'
                    && (request.resource.data.rated != true
                        || (gameData(gameId).rated == true
                            && request.resource.data.ranking.toSet() == gameData(gameId).seats.toSet()
                            && request.resource.data.ranking.size() == gameData(gameId).seats.size()
                            && request.resource.data.playerCount == request.resource.data.ranking.size()
                            && deltasFollowTable(request.resource.data)));
      allow update, delete: if false;
    }

    // ---- 사용자 / 레이팅 (ADR 0007) -----------------------------------------------------------

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 닉네임 길이 2~12. size()는 UTF-16 단위로 센다(에뮬레이터로 확인: 이모지 하나 = 2) -> 앱의 Nicknames도 String.length로 맞춘다.
    function validNickname(name) {
      return name is string && name.size() >= 2 && name.size() <= 12;
    }

    // TableRatingPolicy 와 같은 표. [인원수][순위(0 = 1위)]
    function ratingTable() {
      return {
        '2': [30, -20],
        '3': [50, 20, -40],
        '4': [70, 30, -30, -50],
        '5': [100, 60, 30, -40, -70],
        '6': [130, 70, 40, -30, -60, -90]
      };
    }

    // 규칙 언어에는 반복문이 없어서 최대 인원(6)만큼 펼쳐 쓴다.
    function deltaAt(d, i) {
      return i >= d.ranking.size()
        || d.ratingDeltas[d.ranking[i]] == ratingTable()[string(d.ranking.size())][i];
    }

    function deltasFollowTable(d) {
      return d.ratingDeltas.keys().toSet() == d.ranking.toSet()
        && deltaAt(d, 0) && deltaAt(d, 1) && deltaAt(d, 2)
        && deltaAt(d, 3) && deltaAt(d, 4) && deltaAt(d, 5);
    }

    function profileKeys() {
      return ['nickname', 'rating', 'plays', 'wins', 'createdAt', 'migratedFromLegacy'];
    }

    // 새 프로필: 시작값이거나, 옛 문서 값을 그대로 옮기면서 같은 배치에서 이메일을 선점한다.
    function validNewProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(profileKeys()) && d.keys().hasAll(profileKeys())
        && validNickname(d.nickname)
        && d.wins == 0
        && ((d.migratedFromLegacy == false && d.rating == 1000 && d.plays == 0)
            || (d.migratedFromLegacy == true && validLegacyMigration(d)));
    }

    function validLegacyMigration(d) {
      let email = request.auth.token.email;
      let legacy = /databases/$(database)/documents/user/$(email);
      let claim = /databases/$(database)/documents/legacyClaims/$(email);
      return exists(legacy)
        && d.rating == get(legacy).data.rating
        && d.plays == get(legacy).data.get('plays', 0)
        && !exists(claim)
        && getAfter(claim).data.uid == request.auth.uid;
    }

    function nicknameOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
        && validNickname(request.resource.data.nickname);
    }

    // 공개 프로필: 로그인한 누구나 읽는다(랭킹 조회 포함). 이메일 등 개인 정보는 담지 않는다.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validNewProfile(uid);
      // 본인은 닉네임만. 레이팅·판수·승수는 서버 판정만 바꾼다.
      allow update: if isOwner(uid) && nicknameOnly();
      allow delete: if false;

      // 내 전적 = 반영 표시. 본인만 읽는다. 쓰기는 서버 판정만(같은 트랜잭션에서 레이팅과 함께).
      match /appliedResults/{gameId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---- 방 (ADR 0008) ----------------------------------------------------------------------------
    // 사람 좌석은 members(uid -> {name, readyVersion, seq}) + memberOrder, 봇은 bots. 게스트 준비 = readyVersion == configVersion.
    // 핵심: 게스트는 자기 항목만 바꾸고, 방장은 사람을 넣을 수 없고 뺄 수만 있다 -> 게임 좌석은 항상 스스로 들어온 사람.

    function roomDoc(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function validGameCreate(gameId) {
      let d = request.resource.data;
      let room = getAfter(roomDoc(d.roomId)).data;
      return d.hostUid == request.auth.uid
        && room.hostUid == request.auth.uid
        && room.status == 'PLAYING'
        && room.gameId == gameId
        && d.seats.toSet() == room.memberOrder.toSet()
        && d.seats.size() == room.memberOrder.size()
        && d.rated == (room.bots.size() == 0
                       && room.ruleSet.houseRules.size() == 0
                       && room.ruleSet.paramOverrides.size() == 0)
        && d.createdAt == request.time;
    }

    function readyAt(a, i) {
      return i >= a.memberOrder.size()
        || a.memberOrder[i] == a.hostUid
        || a.members[a.memberOrder[i]].readyVersion == a.configVersion;
    }

    function guestsReady(a) {
      return readyAt(a, 0) && readyAt(a, 1) && readyAt(a, 2)
        && readyAt(a, 3) && readyAt(a, 4) && readyAt(a, 5);
    }

    function validRoomCreate(roomId) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      return d.hostUid == uid
        && d.members.keys().toSet() == [uid].toSet()
        && d.memberOrder == [uid]
        && d.bots.size() == 0
        && d.status == 'WAITING'
        && d.gameId == null
        && d.banned.size() == 0
        && d.version == 1
        && d.configVersion == 0
        && d.maxPlayers >= 2 && d.maxPlayers <= 6
        && d.updatedAt == request.time
        && ((d.visibility == 'PUBLIC' && !('joinCode' in d))
            || (d.visibility == 'PRIVATE' && d.joinCode is string
                && getAfter(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.roomId == roomId));
    }

    // 모든 수정에 공통: 크기·명단 모양.
    function roomShapeOk() {
      let a = request.resource.data;
      return a.maxPlayers >= 2 && a.maxPlayers <= 6
        && a.memberOrder.size() + a.bots.size() <= a.maxPlayers
        && a.memberOrder.toSet() == a.members.keys().toSet()
        && a.memberOrder.size() == a.members.size();
    }

    function hostRoomUpdate() {
      let b = resource.data;
      let a = request.resource.data;
      let changed = a.diff(b).affectedKeys();
      let m = a.members.diff(b.members);
      let configChanged = changed.hasAny(['ruleSet', 'bots']);
      return changed.hasOnly(['title', 'maxPlayers', 'ruleSet', 'bots', 'configVersion', 'status', 'gameId',
                              'banned', 'members', 'memberOrder', 'version', 'updatedAt'])
        // 사람은 뺄 수만 있다(강퇴). 넣거나 고칠 수 없다.
        && m.addedKeys().size() == 0
        && m.changedKeys().size() == 0
        && request.auth.uid in a.members
        // 룰셋·봇을 바꾸면 게스트 준비를 푼다
        && (a.configVersion == b.configVersion || a.configVersion == b.configVersion + 1)
        && (!configChanged || a.configVersion == b.configVersion + 1)
        && (b.status == 'WAITING' || changed.hasOnly(['status', 'gameId', 'configVersion', 'version', 'updatedAt']))
        && (a.status == 'CLOSED'
            || (b.status == 'WAITING' && a.status == 'WAITING' && !changed.hasAny(['gameId']))
            || (b.status == 'WAITING' && a.status == 'PLAYING' && a.gameId is string && !configChanged && guestsReady(a))
            || (b.status == 'PLAYING' && a.status == 'WAITING' && a.gameId == null)
            || (b.status == 'PLAYING' && a.status == 'PLAYING' && !changed.hasAny(['gameId'])));
    }

    function guestRoomUpdate() {
      let b = resource.data;
      let a = request.resource.data;
      let uid = request.auth.uid;
      let m = a.members.diff(b.members);
      return a.diff(b).affectedKeys().hasOnly(['members', 'memberOrder', 'version', 'updatedAt'])
        && b.status == 'WAITING'
        && m.affectedKeys().hasOnly([uid])
        && m.affectedKeys().size() == 1
        && (guestJoin(b, a, uid) || guestLeave(b, a, uid) || guestReady(b, a, uid));
    }

    function guestJoin(b, a, uid) {
      let e = a.members[uid];
      return !(uid in b.members)
        && !(uid in b.banned)
        && a.memberOrder == b.memberOrder.concat([uid])
        && e.keys().hasOnly(['name', 'readyVersion', 'seq'])
        && e.keys().hasAll(['name', 'readyVersion', 'seq'])
        && e.name is string && e.name.size() >= 1 && e.name.size() <= 20
        && e.readyVersion == -1
        && e.seq is int;
    }

    function guestLeave(b, a, uid) {
      return (uid in b.members) && !(uid in a.members)
        && a.memberOrder == b.memberOrder.removeAll([uid]);
    }

    function guestReady(b, a, uid) {
      return (uid in b.members) && (uid in a.members)
        && a.memberOrder == b.memberOrder
        && a.members[uid].diff(b.members[uid]).affectedKeys().hasOnly(['readyVersion'])
        && (a.members[uid].readyVersion == -1 || a.members[uid].readyVersion == b.configVersion);
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      // 목록은 공개 방만(쿼리가 visibility == 'PUBLIC'로 거른 경우에만 허용된다). 비공개 방 ID는 코드로만 알 수 있다.
      allow list: if signedIn() && resource.data.visibility == 'PUBLIC';
      allow create: if signedIn() && validRoomCreate(roomId);
      allow update: if signedIn()
                    && resource.data.status != 'CLOSED'
                    && request.resource.data.version == resource.data.version + 1
                    // 모든 쓰기에 서버 시각(ADR 0016): 오래 안 바뀐 대기실은 서버가 닫는다. 방장은 몇 분마다 시각만 새로 쓴다.
                    && request.resource.data.updatedAt == request.time
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['hostUid', 'createdAt', 'minAppVersion', 'visibility', 'joinCode'])
                    && roomShapeOk()
                    && (resource.data.hostUid == request.auth.uid ? hostRoomUpdate() : guestRoomUpdate());
      allow delete: if false;
    }

    // 비공개 방 참가 코드: 방을 만드는 같은 배치에서 방장이 선점, 방이 닫히면 방장이 푼다. 목록 조회 불가(추측 방지).
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && !exists(roomDoc(request.resource.data.roomId))
                    && getAfter(roomDoc(request.resource.data.roomId)).data.hostUid == request.auth.uid
                    && getAfter(roomDoc(request.resource.data.roomId)).data.joinCode == code;
      allow delete: if signedIn()
                    && getAfter(roomDoc(resource.data.roomId)).data.hostUid == request.auth.uid
                    && getAfter(roomDoc(resource.data.roomId)).data.status == 'CLOSED';
      allow update: if false;
    }

    // 옛 계정 이관 선점: 한 이메일은 한 번만 옮긴다.
    match /legacyClaims/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow create: if signedIn() && request.auth.token.email == email
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 옛 앱의 사용자 문서: 본인 이메일 것만 읽는다. ⚠ 이 규칙을 배포하면 옛 앱은 더 이상 쓰지 못한다.
    match /user/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // 그 밖의 경로는 모두 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
